{
    "name": "syntax-highlighter-ng",
    "displayName": "New Syntax Highlighter",
    "description": "Syntax highlighting based on Tree-sitter",
    "homepage": "https://github.com/fallenwood/syntax-highlighter",
    "version": "0.7.0",
    "publisher": "fallenwood",
    "license": "MIT",
    "icon": "images/syntax.png",
    "galleryBanner": {
        "color": "#263238",
        "theme": "dark"
    },
    "repository": {
        "url": "https://github.com/fallenwood/syntax-highlighter"
    },
    "author": {
        "name": "Fallenwood",
        "email": "fallenwood.y@outlook.com"
    },
    "categories": [
        "Programming Languages",
        "Themes",
        "Other"
    ],
    "keywords": [
        "Syntax",
        "Highlighter",
        "Highlight",
        "Highlighting",
        "Coloring",
        "Tree-Sitter",
        "Parser",
        "C",
        "C++",
        "CPP",
        "CSharp",
        "Python",
        "TypeScript",
        "TS",
        "TypeScriptReact",
        "TSX",
        "JavaScript",
        "JS",
        "Go",
        "Rust",
        "Php",
        "Ruby",
        "ShellScript",
        "Bash",
        "OCaml",
        "Lua"
    ],
    "activationEvents": [
        "onLanguage:c",
        "onLanguage:cpp",
        "onLanguage:csharp",
        "onLanguage:python",
        "onLanguage:typescript",
        "onLanguage:typescriptreact",
        "onLanguage:javascript",
        "onLanguage:go",
        "onLanguage:rust",
        "onLanguage:php",
        "onLanguage:ruby",
        "onLanguage:shellscript",
        "onLanguage:ocaml",
        "onLanguage:lua",
        "onLanguage:elixir"
    ],
    "main": "./out/extension.js",
    "scripts": {
        "vscode:package": "./node_modules/.bin/vsce package",
        "vscode:prepublish": "yarn run compile",
        "vscode:publish": "./node_modules/.bin/vsce publish",
        "compile": "tsc -p ./",
        "watch": "tsc -watch -p ./",
        "benchmark:complex-scopes": "ts-node ./scripts/benchmarkComplexScopes.ts",
        "pretest": "yarn run compile && yarn run lint",
        "lint": "eslint src --ext ts",
        "test": "mocha \"./out/test/**/*.test.js\"",
        "postinstall": "ts-node ./scripts/build.ts"
    },
    "engines": {
        "vscode": "^1.80.0"
    },
    "devDependencies": {
        "@types/glob": "^8.1.0",
        "@types/mocha": "^10.0.10",
        "@types/node": "20.2.5",
        "@types/vscode": "^1.80.0",
        "@typescript-eslint/eslint-plugin": "^6.21.0",
        "@typescript-eslint/parser": "^6.21.0",
        "@vscode/test-electron": "^2.5.2",
        "@vscode/vsce": "^2.32.0",
        "eslint": "^8.57.1",
        "glob": "^8.1.0",
        "mocha": "^10.8.2",
        "tree-sitter-bash": "^0.25.1",
        "tree-sitter-c": "^0.24.1",
        "tree-sitter-c-sharp": "^0.23.1",
        "tree-sitter-cli": "^0.26.8",
        "tree-sitter-cpp": "^0.23.4",
        "tree-sitter-go": "^0.25.0",
        "tree-sitter-javascript": "^0.25.0",
        "tree-sitter-lua": "^2.1.3",
        "tree-sitter-ocaml": "^0.24.2",
        "tree-sitter-python": "^0.25.0",
        "tree-sitter-ruby": "^0.23.1",
        "tree-sitter-rust": "^0.24.0",
        "tree-sitter-typescript": "^0.23.2",
        "ts-node": "^10.9.2",
        "typescript": "~5.3.3"
    },
    "dependencies": {
        "jsonc-parser": "^3.3.1",
        "tree-sitter-elixir": "^0.3.5",
        "tree-sitter-php": "^0.24.2",
        "web-tree-sitter": "^0.26.8"
    },
    "contributes": {
        "semanticTokenTypes": [
            {
                "id": "punctuation",
                "description": "Punctuation symbols"
            }
        ],
        "semanticTokenScopes": [
            {
                "scopes": {
                    "punctuation": [
                        "punctuation"
                    ],
                    "type.modification": [
                        "storage.modifier"
                    ]
                }
            }
        ],
        "configuration": {
            "title": "{Syntax Highlighter} configuration",
            "properties": {
                "syntax.highlightComment": {
                    "description": "Enable highlighting of comments",
                    "type": "boolean",
                    "default": true
                },
                "syntax.highlightLanguages": {
                    "description": "Enabled languages",
                    "type": "array",
                    "default": [
                        "c",
                        "cpp",
                        "csharp",
                        "python",
                        "typescript",
                        "typescriptreact",
                        "javascript",
                        "go",
                        "rust",
                        "php",
                        "ruby",
                        "shellscript",
                        "ocaml",
                        "lua",
                        "d",
                        "elixir"
                    ]
                },
                "syntax.highlightTerms": {
                    "description": "Enabled terms",
                    "type": "array",
                    "default": [
                        "type",
                        "scope",
                        "function",
                        "variable",
                        "number",
                        "string",
                        "comment",
                        "constant",
                        "directive",
                        "control",
                        "operator",
                        "modifier",
                        "punctuation",
                        "async",
                        "parameter"
                    ]
                },
                "syntax.debugHover": {
                    "description": "Show tool-tip with syntax scope on hover",
                    "type": "boolean",
                    "default": false
                },
                "syntax.debugDepth": {
                    "description": "Depth of syntax scope in debug tools",
                    "type": "integer",
                    "default": -1
                }
            }
        }
    },
    "packageManager": "yarn@1.22.22+sha512.a6b2f7906b721bba3d67d4aff083df04dad64c399707841b7acf00f6b133b7ac24255f2652fa22ae3534329dc6180534e98d17432037ff6fd140556e2bb3137e"
}
